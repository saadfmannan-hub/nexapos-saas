# ---------------------------------------------------------------
# NexaPOS environment configuration (copy to .env and edit)
# ---------------------------------------------------------------

# Platform branding (white-label ready)
PRODUCT_NAME=NexaPOS
PLATFORM_SUPPORT_EMAIL=nexabusinesssolutions360@gmail.com
PLATFORM_WEBSITE=https://example.com
PLATFORM_TERMS_URL=
PLATFORM_PRIVACY_URL=
PLATFORM_PRIMARY_COLOR=#0d6efd

# Core Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Backup v1's snapshot provider supports a local SQLite database only.
# Use an absolute persistent production path; do not place it on network storage.
# DATABASE_URL=sqlite:////var/lib/nexapos/db.sqlite3
# PostgreSQL remains supported by the application, but not by Backup v1 snapshots.
# DATABASE_URL=postgres://nexapos:password@db.internal:5432/nexapos

# Redis / Celery (optional in local development; dedicated Redis is required
# before production backup UAT). Values below are placeholders only.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# ---------------------------------------------------------------
# Backup activation flags
# Keep both false during deployment and production preparation. Restore is a
# later, separately approved gate after a successful backup UAT.
# ---------------------------------------------------------------
BACKUP_EXECUTION_ENGINE_ENABLED=False
BACKUP_RESTORE_MUTATION_ENABLED=False

# ---------------------------------------------------------------
# Celery production queues and control-plane timing
# Queue names are fixed security boundaries; do not merge these queues.
# Exactly one Beat process owns the schedule.
# ---------------------------------------------------------------
BACKUP_EXECUTION_QUEUE_NAME=nexa.backups
BACKUP_SCHEDULER_QUEUE_NAME=nexa.backup_scheduling
BACKUP_RESTORE_QUEUE_NAME=nexa.restores
BACKUP_SCHEDULE_DISPATCH_INTERVAL_SECONDS=300
BACKUP_RECONCILIATION_INTERVAL_SECONDS=600
BACKUP_DISPATCH_RECONCILE_AFTER_SECONDS=300
BACKUP_DISPATCH_MAX_IMMEDIATE_ATTEMPTS=3
BACKUP_DISPATCH_MAX_TOTAL_ATTEMPTS=12
BACKUP_QUEUED_AGE_WARNING_SECONDS=900
BACKUP_RESTORE_QUEUED_AGE_WARNING_SECONDS=900
BACKUP_FAILED_COUNT_WARNING=1
BACKUP_STALE_OPERATION_SECONDS=21600
BACKUP_EXECUTION_TASK_SOFT_TIME_LIMIT_SECONDS=21600
BACKUP_EXECUTION_TASK_TIME_LIMIT_SECONDS=21900
BACKUP_RESTORE_TASK_SOFT_TIME_LIMIT_SECONDS=43200
BACKUP_RESTORE_TASK_TIME_LIMIT_SECONDS=43500

# ---------------------------------------------------------------
# Backup local development only
# Never use the local key/storage providers for production activation.
# ---------------------------------------------------------------
BACKUP_KEY_PROVIDER=local
BACKUP_LOCAL_KEK_B64=
BACKUP_LOCAL_KEK_ID=
BACKUP_LOCAL_KEK_VERSION=
BACKUP_STORAGE_PROVIDER=local
# BACKUP_DURABLE_STORAGE_ROOT=C:\private\nexa-durable-backups
BACKUP_DURABLE_STORAGE_REQUIRE_LOCAL=True

# ---------------------------------------------------------------
# Backup production KMS
# Credentials come from the runtime AWS-compatible credential chain or secret
# manager and must never be committed to this file.
# ---------------------------------------------------------------
# BACKUP_KEY_PROVIDER=aws_kms
BACKUP_AWS_KMS_KEY_ID=
BACKUP_AWS_REGION=

# ---------------------------------------------------------------
# Backup production S3 / DigitalOcean Spaces
# Use a private bucket. These are identifiers and policy values, not credentials.
# ---------------------------------------------------------------
# BACKUP_STORAGE_PROVIDER=s3
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_PREFIX=nexa/backups
BACKUP_S3_ADDRESSING_STYLE=auto
BACKUP_S3_MULTIPART_THRESHOLD_BYTES=67108864
BACKUP_S3_MULTIPART_PART_BYTES=16777216
BACKUP_S3_CONNECT_TIMEOUT_SECONDS=10
BACKUP_S3_READ_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------
# Private staging/workspace and SQLite snapshot policy
# Production example: /var/lib/nexapos/backup-staging
# The path must be absolute, private, local, and outside the application,
# MEDIA_ROOT, and STATIC_ROOT. Staging is transient and is not a durable backup.
# ---------------------------------------------------------------
# BACKUP_STAGING_ROOT=/var/lib/nexapos/backup-staging
BACKUP_WORKSPACE_CLEANUP_TIMEOUT_SECONDS=3600
BACKUP_SQLITE_REQUIRED_JOURNAL_MODE=WAL
BACKUP_SQLITE_REQUIRED_SYNCHRONOUS=FULL
BACKUP_SQLITE_BUSY_TIMEOUT_SECONDS=5
BACKUP_SQLITE_BACKUP_PAGES_PER_STEP=256
BACKUP_SQLITE_BACKUP_SLEEP_SECONDS=0.05
BACKUP_SQLITE_SNAPSHOT_TIMEOUT_SECONDS=300
BACKUP_SQLITE_MIN_FREE_BYTES=1073741824
BACKUP_SQLITE_HEADROOM_MULTIPLIER=3.0
BACKUP_SQLITE_REQUIRE_LOCAL_STAGING=True
BACKUP_LOGICAL_EXPORT_FETCH_BATCH_SIZE=200
BACKUP_LOGICAL_EXPORT_COMPONENT_TIMEOUT_SECONDS=120
BACKUP_LOGICAL_EXPORT_MAX_RECORDS_BYTES=536870912
BACKUP_LOGICAL_EXPORT_MAX_MEDIA_INDEX_BYTES=33554432
BACKUP_LOGICAL_EXPORT_MAX_ROW_INPUT_BYTES=65536
BACKUP_LOGICAL_EXPORT_MAX_JSON_DEPTH=20
BACKUP_LOGICAL_EXPORT_MAX_MEDIA_NAME_LENGTH=1024
BACKUP_MEDIA_CAPTURE_CHUNK_BYTES=1048576
BACKUP_MEDIA_CAPTURE_MAX_FILE_BYTES=67108864
BACKUP_MEDIA_CAPTURE_MAX_TOTAL_BYTES=4294967296
BACKUP_MEDIA_CAPTURE_MAX_OBJECTS=100000
BACKUP_MEDIA_CAPTURE_TIMEOUT_SECONDS=1800
BACKUP_MEDIA_CAPTURE_MIN_FREE_BYTES=1073741824
BACKUP_MEDIA_CAPTURE_HEADROOM_MULTIPLIER=1.25
BACKUP_MEDIA_CAPTURE_REQUIRE_LOCAL_STAGING=True
BACKUP_MEDIA_INDEX_MAX_LINE_BYTES=65536
BACKUP_ENCRYPTION_CHUNK_BYTES=1048576
BACKUP_ENCRYPTION_MAX_PLAINTEXT_BYTES=10995116277760
BACKUP_ENCRYPTION_MAX_ARTIFACT_BYTES=10995133054976
BACKUP_ENCRYPTION_TIMEOUT_SECONDS=1800
BACKUP_ENCRYPTION_MIN_FREE_BYTES=1073741824
BACKUP_ENCRYPTION_HEADROOM_MULTIPLIER=1.25
BACKUP_ENCRYPTION_MAX_HEADER_BYTES=65536
BACKUP_DURABLE_STORAGE_CHUNK_BYTES=1048576
BACKUP_DURABLE_STORAGE_MAX_OBJECT_BYTES=10995133054976
BACKUP_DURABLE_STORAGE_TIMEOUT_SECONDS=3600
BACKUP_DURABLE_STORAGE_MIN_FREE_BYTES=1073741824
BACKUP_DURABLE_STORAGE_HEADROOM_MULTIPLIER=1.25
BACKUP_RETENTION_DAILY_FULL_KEEP_COUNT=5
BACKUP_RETENTION_MAX_DELETE_BATCH=100
BACKUP_RETENTION_TIMEOUT_SECONDS=300
BACKUP_EXECUTION_LOCK_LEASE_SECONDS=21600

# Email (console backend is used in development when unset)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Security (production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Trials
DEFAULT_TRIAL_DAYS=14
